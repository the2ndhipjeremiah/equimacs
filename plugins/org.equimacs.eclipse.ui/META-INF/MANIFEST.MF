Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Equimacs UI
Bundle-SymbolicName: org.equimacs.eclipse.ui;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Require-Bundle: org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.swt,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.filebuffers,
 org.eclipse.core.commands,
 com.google.gson
Import-Package: org.equimacs.eclipse.bridge.api,
 org.equimacs.protocol
Service-Component: OSGI-INF/ReviewCommandHandler.xml
Bundle-RequiredExecutionEnvironment: JavaSE-26
Eclipse-BundleShape: dir
Automatic-Module-Name: org.equimacs.eclipse.ui
